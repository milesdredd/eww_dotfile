(defwindow barbgW
  :monitor "eDP-1"
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "0px")
  :exclusive true
  :anchor "center"
  :stacking "fg"
  :namespace "top-panel-blur"
  (barbg :orientation "h")
)


(defwidget barbg []
    (revealer
        :reveal bar
        :valign "start"
        :transition "slidedown"
        :duration "600ms"
        (box  :class "platee"
        :height 21
(label :text "  ")

        )
    )
)

(defwidget bar1 []
    (revealer
        :reveal bar
        :valign "start"
        :transition "slidedown"
        :duration "600ms"
        (box  :class ""
        :height 28

            (centerbox
            :valign "start"


            :class "plate box-shadow"
            :height 20
                (box
                :spacing 1
                :space-evenly true
                :orientation "h"
                                    (sys_info)
                )
                (box
                :spacing 7
                :space-evenly 1
                :orientation "h"
                                    (clock)
                )
                (box
                :class ""
                :halign "end"
                :spacing 5
                :space-evenly false
                :orientation "h"

                                   (wifi) (Bluetooth)
                                    (br)
                                    (vol)
                              (tray)
                                    (battery)
                                    (power)
                )
            )
        )
    )
)
