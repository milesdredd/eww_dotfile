
(defpoll note_content
  :interval "1h"
  `~/.config/eww/scripts/load-note.sh`)

(defwindow NotesUi
  :monitor "eDP-1"
    :geometry (geometry
    :width "100%"
    :height "40%")
  :anchor "right"
  :exclusive "false"
  :stacking "bg"
  :focusable "true"
  :namespace "task"
  :visible true
  :type "toolbar"

  (note-box)
)

(defwidget note-box []
          (scroll
            :vscroll true


                      (box
                        :class "new"
                        :orientation "v"
                        :space-evenly false
                        :spacing 0
                                (box
                                        :class "border new2"
                                        :height 380
                                        :orientation "v"
                                        :space-evenly false

                                        (scroll
                                          :vscroll true

                                          (textarea
                                            :text note_content
                                            :onchange "eww update note_content=\"{}\""
                                          )
                                        )

                                        (button
                                          :onclick "printf '%s' \"$EWW_NOTE_CONTENT\" | ~/.config/eww/scripts/save-note.sh"
                                          "Save"
                                        )
                                      )



                      )
            )
)
