
(defwindow widget
  :monitor "eDP-1"
  :geometry (geometry :x "0px" :y "50px" :width "100%" :height "240px")
  :anchor "bottom"
  :exclusive false
  :stacking "bg"
  :visible true
  :type "normal"
  :namespace "awww-daemon"
  (widget-box )
)
(defwidget widget-box[]
    (box :class ""
    :orientation "v"
        (overlay

                (label
                    :valign "start"
                    :class "desktop-clock font1 "
                    :text "${time.day} ${time.date} ${time.month} ${time.yr}\""
                )
                (label
                :valign "center"
                    :class "desktop-clock font1 "
                    :text "${time.hour}:${time.min}"
                )
        )
    )

)
