(defwindow calender
  :monitor "eDP-1"
  :geometry (geometry :x "0%" :y "50%" :width "330px" :height "120px")
  :anchor "center"
  :exclusive "false"
  :stacking "bg"
  :focusable "false"
  ;:windowtype "normal"
  :namespace "calendar"
  :visible true
  :type "toolbar"
  (calender-box )
)
(defwidget calender-box []
    (box :class "clipboard "
        (box :class ""
        (calendar :class "cal "
        :show-heading true
        :month {formattime(EWW_TIME, "%m")}

        
        
        )
            
        )
    )
)