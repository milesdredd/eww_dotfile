(defpoll tasks :interval "1s" "/home/milesdredd/.config/eww/modules/get_clipboard_tasks.sh")
(defwindow task
  :monitor "eDP-1"
  :geometry (geometry
    :x "89%"
    :y "60%"
    :width "130px"
    :height "260px")
  :anchor "center"
  :exclusive "false"
  :stacking "bg"
  :focusable "false"
  :namespace "task"
  :visible true
  :type "toolbar"

  (task-box)
)

(defwidget task-box []
(scroll
  :vscroll true


  (box
    :class ""
    :orientation "v"
    :space-evenly false
    :spacing 3
    (box :orientation "h"
      (button
        :class "taskk"
        :space-evenly false
        :height 25
        :onclick "/home/milesdredd/.config/niri/struts.sh && 1"
        (label
          :class "big"
          :text ""
        )
      )
      (button
        :class "taskk"
        :space-evenly false
        :height 25
        :onclick "eww close task && 1"
        (label
          :class "big"
          :text " x "
        )
      )
    )
    (for task in tasks
      (button
        :class "taskk"
        :space-evenly false
        :height 25
        :onclick "bash -c \"${task.cmd}\" && 1"
        (label
          :class ""
          :text "${task.name}"
        )
      )
    )
  )
  )
)
